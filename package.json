{
  "name": "senyu-design-studio",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n api,web,admin -c cyan,magenta,blue \"pnpm --dir apps/api dev\" \"pnpm --dir apps/web dev\" \"pnpm --dir apps/admin dev\"",
    "build": "pnpm db:generate && pnpm --dir apps/api build && pnpm --dir apps/admin build && pnpm --dir apps/web build",
    "typecheck": "tsc -p apps/api --noEmit && tsc -p apps/admin --noEmit && tsc -p apps/web --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "setup:local": "node scripts/setup-dev.mjs",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write apps packages scripts tests *.json *.yaml",
    "setup:production": "node scripts/setup-production.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "assets:demo": "node scripts/generate-demo-assets.mjs"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.19.2",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "matter-js": "^0.20.0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.0",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/matter-js": "^0.20.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "3.6.0",
    "prisma": "6.19.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
