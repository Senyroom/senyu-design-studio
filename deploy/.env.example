# Copy to .local/production.env. Use hexadecimal database passwords (no URL escaping needed).
MYSQL_PASSWORD=GENERATE_48_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=GENERATE_ANOTHER_48_HEX_CHARACTERS
REVALIDATE_SECRET=GENERATE_64_HEX_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_A_STRONG_PASSWORD
SITE_URL=http://localhost:8080
# Set true when SITE_URL is your actual https:// domain.
COOKIE_SECURE=false
