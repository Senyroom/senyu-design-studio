# Add these locations inside the BaoTa Node web site's existing server block.
# Keep BaoTa's existing HTTPS/certificate configuration and location / -> 3100.
# Replace /www/wwwroot/example.com/public with your dedicated static directory.
client_max_body_size 13m;

location = /admin { return 308 /admin/; }
location /admin/ {
    root /www/wwwroot/example.com/public;
    try_files $uri $uri/ /admin/index.html;
    add_header Cache-Control "no-cache";
}
location /api/v1/ {
    proxy_pass http://127.0.0.1:4100;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
location /media/ {
    proxy_pass http://127.0.0.1:4100;
    proxy_set_header Host $host;
    proxy_cache off;
}
location = /api/revalidate { return 404; }
location /api/docs { return 404; }
location ~ /\. { deny all; }
